@model List<RaceDay.Mvc.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Race Results";
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="fw-bold">My Race Results</h1><p class="text-muted">View your recorded race performances.</p></div><a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Dashboard</a></div>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info rounded-4">You do not have any race results yet. Results will appear here after an organiser records them.</div>
    }
    else
    {

        <div class="card border-0 shadow-sm rounded-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Event</th><th>Category</th><th>Finish time</th><th>Overall position</th><th>Category position</th><th>Status</th><th>Recorded</th></tr></thead><tbody>@foreach(var result in Model){
            <tr><td>@result.EventName</td><td>@result.CategoryName</td><td>@(result.FinishTimeSeconds.HasValue ? TimeSpan.FromSeconds(result.FinishTimeSeconds.Value).ToString(@"hh\:mm\:ss") : "—")</td><td>@(result.OverallPosition?.ToString() ?? "—")</td><td>@(result.CategoryPosition?.ToString() ?? "—")</td><td><span class="badge bg-secondary">@result.Status</span></td><td>@result.RecordedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr>
        }
    </tbody></table></div></div>
}
</div>
