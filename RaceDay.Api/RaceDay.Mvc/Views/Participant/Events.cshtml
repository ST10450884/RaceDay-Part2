@model List<RaceDay.Mvc.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Browse Events</h1>
            <p class="text-muted">Find your next RaceDay challenge.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-body p-4">

                            <span class="badge bg-primary mb-3">
                                @item.EventType
                            </span>

                            <h4 class="fw-bold">@item.Name</h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Venue:</strong>
                                @item.Venue
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.City, @item.Province
                            </p>

                            <p>
                                <strong>Registration closes:</strong>
                                @item.RegistrationCloseDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Status:</strong>
                                @item.Status
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Categories"
                               asp-route-id="@item.EventId"
                               class="btn btn-primary w-100 rounded-pill mt-3">
                                View Categories
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
