@model List<RaceDay.Mvc.Models.EventCategoryViewModel>

@{
    ViewData["Title"] = "Event Categories";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var posterUrl = ViewBag.EventPosterUrl as string;
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">@ViewBag.EventName</h1>
            <p class="text-muted mb-0">
                Choose an event category to enrol in.
            </p>
        </div>

        <a asp-controller="Participant"
           asp-action="Events"
           class="btn btn-outline-secondary rounded-pill">
            Back to Events
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(posterUrl))
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <img src="@($"{apiBaseUrl}{posterUrl}")"
                 alt="@ViewBag.EventName event poster"
                 class="img-fluid w-100"
                 style="max-height: 400px; object-fit: contain; background: #f8f9fa;" />
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <h3 class="fw-bold mb-4">Available Categories</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories are currently available for this event.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-body p-4">

                            <h5 class="fw-bold mb-3">
                                @category.Name
                            </h5>

                            <p>
                                <strong>Distance:</strong>
                                @category.DistanceKm km
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @category.Fee.ToString("N2")
                            </p>

                            <p>
                                <strong>Minimum Age:</strong>
                                @category.MinimumAge
                            </p>

                            <p>
                                <strong>Capacity:</strong>
                                @category.Capacity participants
                            </p>

                            <p>
                                <strong>Start Time:</strong>
                                @category.StartTime
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Enrol"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-primary w-100 rounded-pill mt-3">
                                Enrol Now
                            </a>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
