@model RaceDay.Mvc.Models.ParticipantDashboardViewModel

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">

    <div class="p-4 p-md-5 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102b46, #087e8b);">

        <h1 class="display-5 fw-bold">Welcome to RaceDay!</h1>

        <p class="lead mb-0">
            Hello, @Model.ParticipantName.
            Ready for your next challenge?
        </p>
    </div>

    <h2 class="fw-bold mb-4">Your RaceDay Overview</h2>

    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Total Enrolments</h6>
                    <h2 class="fw-bold">@Model.TotalEvents</h2>
                    <p class="mb-0 text-muted">All your registered events</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Upcoming Events</h6>
                    <h2 class="fw-bold text-primary">@Model.UpcomingEvents</h2>
                    <p class="mb-0 text-muted">Events still to come</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Completed Events</h6>
                    <h2 class="fw-bold text-success">@Model.CompletedEvents</h2>
                    <p class="mb-0 text-muted">Events you've completed</p>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h4 class="fw-bold">Ready to race?</h4>

            <p class="text-muted">
                Discover upcoming sporting events and find your next challenge.
            </p>

            <a asp-controller="Participant"
               asp-action="Events"
               class="btn btn-primary rounded-pill px-4">
                Browse Events
            </a>

        </div>
    </div>

</div>
