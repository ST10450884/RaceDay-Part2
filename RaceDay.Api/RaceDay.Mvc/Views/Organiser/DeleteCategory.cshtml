@model RaceDay.Mvc.Models.EventCategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h1 class="fw-bold text-danger">Delete Category</h1>

                    <p class="text-muted">
                        Are you sure you want to delete this category?
                    </p>

                    <div class="alert alert-warning">
                        <strong>Warning:</strong> Categories with existing
                        participant enrolments cannot be deleted.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-5">Category</dt>
                        <dd class="col-sm-7">@Model.Name</dd>

                        <dt class="col-sm-5">Event</dt>
                        <dd class="col-sm-7">@Model.EventName</dd>

                        <dt class="col-sm-5">Distance</dt>
                        <dd class="col-sm-7">@Model.DistanceKm km</dd>

                        <dt class="col-sm-5">Fee</dt>
                        <dd class="col-sm-7">R @Model.Fee.ToString("N2")</dd>

                        <dt class="col-sm-5">Minimum Age</dt>
                        <dd class="col-sm-7">@Model.MinimumAge</dd>

                        <dt class="col-sm-5">Capacity</dt>
                        <dd class="col-sm-7">@Model.Capacity</dd>
                    </dl>

                    <form asp-action="DeleteCategoryConfirmed"
                          asp-route-id="@Model.CategoryId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger rounded-pill">
                            Yes, Delete Category
                        </button>

                        <a asp-action="Categories"
                           class="btn btn-outline-secondary rounded-pill">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
