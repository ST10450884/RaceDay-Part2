@model RaceDay.Mvc.Models.ResultViewModel
@{
    ViewData["Title"] = "Edit Result";
}
<div class="container py-5" style="max-width:800px">
    <div class="mb-4"><h1 class="fw-bold">Edit Race Result</h1><p class="text-muted">@Model.EventName — @Model.CategoryName</p></div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="EditResult" asp-route-id="@Model.ResultId" method="post">
                @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ResultId" /><div class="mb-3"><label class="form-label">Participant</label><input class="form-control" value="@Model.ParticipantEmail" readonly /></div>
                <div class="mb-3"><label asp-for="FinishTimeSeconds" class="form-label">Finish time (seconds)</label><input asp-for="FinishTimeSeconds" type="number" min="0" class="form-control" /></div>
                <div class="row"><div class="col-md-6 mb-3"><label asp-for="OverallPosition" class="form-label">Overall position</label><input asp-for="OverallPosition" type="number" min="1" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="CategoryPosition" class="form-label">Category position</label><input asp-for="CategoryPosition" type="number" min="1" class="form-control" /></div></div>
                <div class="mb-4"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>Finished</option><option>DNF</option><option>DNS</option><option>Disqualified</option></select></div>
                <div class="d-flex gap-2"><button type="submit" class="btn btn-primary rounded-pill">Save Changes</button><a asp-action="Results" class="btn btn-outline-secondary rounded-pill">Cancel</a></div>
            </form>
        </div>
    </div>
</div>
