@model RaceDay.Mvc.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">

    <h1 class="fw-bold text-danger mb-3">Delete Event</h1>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="alert alert-warning">
                Are you sure you want to permanently delete this event?
            </div>

            <h3>@Model.Name</h3>

            <p><strong>Event type:</strong> @Model.EventType</p>
            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>
            <p><strong>Venue:</strong> @Model.Venue, @Model.City</p>
            <p><strong>Status:</strong> @Model.Status</p>

            <form asp-action="DeleteEventConfirmed"
                  asp-route-id="@Model.EventId"
                  method="post">

                <button type="submit" class="btn btn-danger rounded-pill px-4">
                    Yes, Delete Event
                </button>

                <a asp-action="Events"
                   class="btn btn-outline-secondary rounded-pill px-4">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
