@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <div class="p-4 p-md-5 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102b46, #087e8b);">

        <h1 class="display-5 fw-bold">Organiser Dashboard</h1>

        <p class="lead mb-0">
            Welcome, @ViewBag.OrganiserEmail.
            Manage your RaceDay events and participants.
        </p>
    </div>

    <h2 class="fw-bold mb-4">Management Overview</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Events</h4>
                    <p class="text-muted">Create, view and manage sporting events.</p>
                    <a asp-controller="Organiser" asp-action="Events"
                       class="btn btn-primary rounded-pill">
                        Manage Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Enrolments</h4>
                    <p class="text-muted">View participants registered for your events.</p>
                    <a asp-controller="Organiser" asp-action="Enrolments"
                       class="btn btn-primary rounded-pill">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Results</h4>
                    <p class="text-muted">Manage race results and participant performance.</p>
                    <a asp-controller="Organiser" asp-action="Results"
                       class="btn btn-primary rounded-pill">
                        Manage Results
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5">
        <a asp-controller="Auth" asp-action="Logout"
           class="btn btn-outline-danger rounded-pill">
            Logout
        </a>
    </div>

</div>
