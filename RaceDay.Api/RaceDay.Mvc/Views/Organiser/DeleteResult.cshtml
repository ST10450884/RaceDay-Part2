@model RaceDay.Mvc.Models.ResultViewModel
@{
    ViewData["Title"] = "Delete Result";
}
<div class="container py-5" style="max-width:700px">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h1 class="fw-bold text-danger">Delete Result</h1><p>Are you sure you want to delete this result?</p><dl class="row"><dt class="col-sm-4">Participant</dt><dd class="col-sm-8">@Model.ParticipantEmail</dd><dt class="col-sm-4">Event</dt><dd class="col-sm-8">@Model.EventName</dd><dt class="col-sm-4">Category</dt><dd class="col-sm-8">@Model.CategoryName</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd></dl>
            <form asp-action="DeleteResultConfirmed" asp-route-id="@Model.ResultId" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger rounded-pill">Delete Result</button> <a asp-action="Results" class="btn btn-outline-secondary rounded-pill">Cancel</a></form>
        </div>
    </div>
</div>
