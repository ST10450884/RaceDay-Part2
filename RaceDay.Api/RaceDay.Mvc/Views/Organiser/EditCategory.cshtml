@model RaceDay.Mvc.Models.EventCategoryViewModel
@using RaceDay.Mvc.Models

@{
    ViewData["Title"] = "Edit Category";
    var events = ViewBag.Events as List<EventViewModel> ?? new List<EventViewModel>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="fw-bold mb-2">Edit Category</h1>
                    <p class="text-muted mb-4">Update your race category details.</p>

                    <form asp-action="EditCategory"
                          asp-route-id="@Model.CategoryId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="CategoryId" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="EventId" class="form-label">Select Event</label>
                            <select asp-for="EventId" class="form-select">
                                @foreach (var eventItem in events)
                                {
                                    <option value="@eventItem.EventId">
                                        @eventItem.Name
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="EventId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Category Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                                <input asp-for="DistanceKm" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="DistanceKm" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Fee" class="form-label">Entry Fee (R)</label>
                                <input asp-for="Fee" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="Fee" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MinimumAge" class="form-label">Minimum Age</label>
                                <input asp-for="MinimumAge" type="number" class="form-control" />
                                <span asp-validation-for="MinimumAge" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Capacity" class="form-label">Capacity</label>
                                <input asp-for="Capacity" type="number" class="form-control" />
                                <span asp-validation-for="Capacity" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label">Start Time</label>
                                <input asp-for="StartTime" type="time" class="form-control" />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary rounded-pill">
                                Save Changes
                            </button>
                            <a asp-action="Categories" class="btn btn-outline-secondary rounded-pill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
